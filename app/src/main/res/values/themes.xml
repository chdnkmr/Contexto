<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Material 3) -->
    <style name="Theme.Contexto" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/muted_sage</item>
        <item name="colorOnPrimary">@color/black</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/intelligent_copper</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Surface and Background -->
        <item name="android:windowBackground">@color/deep_obsidian</item>
        <item name="android:statusBarColor">@color/deep_obsidian</item>
    </style>

    <!-- Splash Screen Theme (API 24-30 Fallback) -->
    <style name="Theme.Contexto.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/deep_obsidian</item>
        <!-- Using a standard android icon as a placeholder for now -->
        <item name="windowSplashScreenAnimatedIcon">@android:drawable/ic_menu_mylocation</item>
        <item name="postSplashScreenTheme">@style/Theme.Contexto</item>
    </style>
</resources>
